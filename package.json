{
  "name": "bizbot-enterprise-monorepo",
  "version": "3.0.0",
  "private": true,
  "description": "BizBot AI — Business Assistant Chatbot Enterprise Platform (GOD-STACK Edition v3.0)",
  "author": "Logic Code Spot (LCS) Software Solutions — Dostin Santana Tejeda",
  "license": "UNLICENSED",
  "scripts": {
    "build": "pnpm --recursive run build",
    "dev": "pnpm --parallel --recursive run dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0"
  }
}
