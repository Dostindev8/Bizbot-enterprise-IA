# ==============================================================================
# BIZBOT AI ENTERPRISE (GOD-STACK EDITION v3.0) — ENVIRONMENT VARIABLES
# ==============================================================================

# --- SERVER ENVIRONMENT ---
NODE_ENV=development
PORT=5000
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# --- SECURITY & SECRETS ---
# RS256 Private/Public key pair or strong HS256 secret for development
JWT_SECRET=bizbot_super_secret_enterprise_jwt_key_minimum_32_characters_long_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Never true in production. Allows MFA code 123456 only for local/demo.
ALLOW_DEMO_MFA=false
ENCRYPTION_KEY=bizbot_32_byte_aes_secret_key_2026_enterprise_lcs

# --- DATABASE (MONGODB REPLICA SET) ---
MONGODB_URI=mongodb://localhost:27017/bizbot_enterprise?replicaSet=rs0
MONGODB_DEBUG=false

# --- REDIS (CACHE & RATE LIMITING) ---
REDIS_URL=redis://localhost:6379
REDIS_TTL_DEFAULT=3600

# --- VECTOR STORE (QDRANT) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- OBJECT STORAGE (S3 / MINIO) ---
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=bizbot-documents
S3_REGION=us-east-1

# --- AI & LLM PROVIDERS ---
ANTHROPIC_API_KEY=sk-ant-api03-placeholder-key-for-dev-mode
OPENAI_API_KEY=sk-openai-placeholder-key-for-dev-mode
AI_DEFAULT_MODEL=claude-3-5-sonnet-latest
AI_FAST_MODEL=claude-3-5-haiku-latest
AI_HIGH_MODEL=claude-3-opus-latest

# --- INTEGRATIONS ---
# Google OAuth & Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/agenda/oauth/google/callback

# Twilio (WhatsApp & SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Stripe (Billing SaaS)
STRIPE_SECRET_KEY=sk_test_placeholder_key_for_dev
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret
STRIPE_PRICE_STARTER=price_starter_placeholder
STRIPE_PRICE_PRO=price_pro_placeholder
STRIPE_PRICE_BUSINESS=price_business_placeholder

# --- CLIENT PUBLIC VARIABLES (safe to expose in the SPA bundle) ---
# Local: Vite proxies /api to localhost:5000. Production (Vercel): keep relative /api/v1.
# NEVER add JWT_SECRET, MONGODB_URI, REDIS_URL, Stripe, Twilio, or LLM keys to Vercel frontend env.
VITE_PUBLIC_API_URL=http://localhost:5000/api/v1
VITE_PUBLIC_SOCKET_URL=http://localhost:5000
VITE_PUBLIC_APP_NAME="BizBot AI Enterprise"

# --- VERCEL PRODUCTION (dashboard only, never commit real values) ---
# Frontend project (this repo / SPA):
#   VITE_PUBLIC_API_URL=/api/v1
#   VITE_PUBLIC_APP_NAME=BizBot AI Enterprise
#   ENABLE_EXPERIMENTAL_COREPACK=1
# API host (separate service — Render/Railway/Vercel Functions):
#   NODE_ENV=production
#   JWT_SECRET=<generate locally, paste in dashboard, never commit>
#   MONGODB_URI=<Atlas URI from dashboard, never commit>
#   CLIENT_URL=https://<your-vercel-app>.vercel.app
#   ALLOW_DEMO_MFA=false
